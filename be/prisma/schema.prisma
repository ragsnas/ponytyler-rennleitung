// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum ShowState {
  LISTED
  BEFORE_SHOW
  BEFORE_RACE
  RACE
  RACE_FINISHED
  PLAYING_VIDEO
  VIDEO_FINISHED
  SHOW_FINISHED
  BEFORE_ENCORE
  PLAYING_ENCORE
  ENCORE_FINISHED
}

model Show {
  id              Int          @id @default(autoincrement())
  name            String       @unique
  date            DateTime?
  actualStartTime DateTime?
  duration        Int?
  finished        Boolean      @default(false)
  showState       ShowState    @default(SHOW_FINISHED)
  active          Boolean      @default(false)
  races           Race[]       @relation(name: "ShowToRace")
  shifts          Shift[]      @relation(name: "ShowToShift")
  encoreSongs     EncoreSong[] @relation(name: "ShowToEncoreSong")
}

model Shift {
  id            Int         @id @default(autoincrement())
  show          Show        @relation(name: "ShowToShift", fields: [showId], references: [id])
  showId        Int
  order         Int
  duration      Int?
  shiftStarted  DateTime?
  shiftFinished DateTime?
  shiftRoles    ShiftRole[] @relation(name: "ShiftToShiftRole")
}

model ShiftRole {
  id           Int     @id @default(autoincrement())
  shift        Shift   @relation(name: "ShiftToShiftRole", fields: [shiftId], references: [id])
  shiftId      Int
  roleTitle    String
  user         User    @relation(name: "ShiftRoleToUser", fields: [userId], references: [id])
  userId       Int
  pastUserName String? // for saving userName of deleted users
}

model Song {
  id              Int          @id @default(autoincrement())
  name            String
  artist          String
  selectable      Boolean      @default(true)
  deleted         Boolean      @default(false)
  origin          String       @default("FROM_FILE_SYNC")
  pickedByPerson1 Race[]       @relation(name: "SongForPerson1")
  pickedByPerson2 Race[]       @relation(name: "SongForPerson2")
  encoreSongs     EncoreSong[] @relation(name: "SongToEncoreSong")
}

model EncoreSong {
  id     Int  @id @default(autoincrement())
  show   Show @relation(name: "ShowToEncoreSong", fields: [showId], references: [id])
  showId Int
  song   Song @relation(name: "SongToEncoreSong", fields: [songId], references: [id])
  songId Int
  order  Int

  @@map("encore_songs")
}

model Race {
  id             Int      @id @default(autoincrement())
  show           Show     @relation(name: "ShowToRace", fields: [showId], references: [id])
  showId         Int
  orderNumber    Int
  createdAt      DateTime @default(now())
  raceStartedAt  DateTime?
  raceFinishedAt DateTime?
  raced          Boolean  @default(false)
  raceState      String   @default("LISTED")
  person1        String?
  song1          Song?    @relation(name: "SongForPerson1", fields: [song1Id], references: [id])
  song1Id        Int?
  person2        String?
  song2          Song?    @relation(name: "SongForPerson2", fields: [song2Id], references: [id])
  song2Id        Int?
  bikeWon        Int      @default(0)
}

enum RaceState {
  WAITING_FOR_OPPONENT
  CANCELED
  LISTED
  WAITING_TO_RACE
  RACING
  RACED
  ERROR
  VIDEO_PLAYING
  DONE
}

model User {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  shiftRoles ShiftRole[] @relation(name: "ShiftRoleToUser")
  password   String?
}
